+        basis_l,
+        basis_m,
+        basisfn_type,
+        atom_Z,
+        ham_out
+    );
+
+    if (rc == 0) {
+        deeph_restart_used_c = 1;
+        return 0;
+    }
+
+    return rc;
+}
+
+void deeph_log_hamiltonian_fingerprint_c(const double *ham, int n_ham_size, int n_spin, const char *stage, int myid) {
+    int i_spin;
+    int i;
+    if (myid != 0 || !ham || !stage) return;
+
+    for (i_spin = 0; i_spin < n_spin; ++i_spin) {
+        double sum2 = 0.0;
+        double max_abs = 0.0;
+        const double *hspin = ham + (size_t)i_spin * (size_t)n_ham_size;
+        for (i = 0; i < n_ham_size; ++i) {
+            double v = hspin[i];
+            double a = fabs(v);
+            sum2 += v * v;
+            if (a > max_abs) max_abs = a;
+        }
+        fprintf(stdout, "  DeepX fingerprint [%s] spin=%d ||H||2=% .16E max|H|=% .16E\n",
+                stage, i_spin + 1, sqrt(sum2), max_abs);
+    }
+    fflush(stdout);
+}
+
+void deeph_dump_hamiltonian_c(const double *ham, int n_ham_size, int n_spin, const char *filename, int myid) {
+    FILE *fp;
+    int i;
+
+    if (myid != 0 || !ham || !filename) return;
+    fp = fopen(filename, "w");
+    if (!fp) return;
+
+    if (n_spin == 1) {
+        fprintf(fp, "# idx  H_up\n");
+        for (i = 0; i < n_ham_size; ++i) {
+            fprintf(fp, "%12d % .16E\n", i + 1, ham[i]);
+        }
+    } else {
+        const double *hup = ham;
+        const double *hdn = ham + n_ham_size;
+        fprintf(fp, "# idx  H_up  H_dn\n");
+        for (i = 0; i < n_ham_size; ++i) {
+            fprintf(fp, "%12d % .16E % .16E\n", i + 1, hup[i], hdn[i]);
+        }
+    }
+
+    fclose(fp);
+}
