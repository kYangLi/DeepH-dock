+
+void rs_mx_trans(const int n_hamiltonian_matrix_size, const int n_cells_in_hamiltonian,
+                const int n_basis, const int n_spin,
+                const double* in_mx, const int* idx_mx, const int* col_idx_mx,
+                const int* cell_idx, 
+                const int* basis_fn, const int* basis_atom, const int* basisfn_n, 
+                const int* basis_l, const int* basis_m,
+                const char* out_filename) {
+/*
+becareful with that matrix storage in Fortran is column-major
+thus in C, we need to swap row and column when accessing the matrix elements
+Fortran: mx(i1, i2, i3) --> C: mx[i1 + i2 * dim1 + i3 * dim1 * dim2]
+
+here, we not parse structures, just the raw arrays.
+
+shape:
+    im_mx: (n_hamiltonian_matrix_size)
+    idx_mx: (2, n_cells_in_hamiltonian, n_basis)
+    col_idx_mx: (n_hamiltonian_matrix_size)
+    cell_idx: (3, n_cells_in_hamiltonian)
+
+deeph data structure ref:
+    atom_pairs: (n_atom_pairs, 5), int
+                each row: [R1, R2, R3; i_atom, j_atom]
+    chunk_boundaries: (n_atom_pairs+1,), int
+                each element: starting index of each chunk in atom_pairs
+    chunk_shape: (n_atom_pairs, 2), int
+                each row: [n_rows, n_cols] of the corresponding chunk
+                         n_rows_i * n_cols_i = chunk_boundaries(i+1) - chunk_boundaries(i)
+    entries: (M,), double if spinless or ovlp, complex double if spinful
+                sorted entries of all chunks concatenated
+
+matrix ref:
+!             Example with cell_index(1,:) == 0,
+!                          cell_index(2,:) == - cell_index(3,:):
+!                       j=1   j=2
+!             i=1 R=1 (  1     2  )   ! index_hamiltonian(:,1,1) = [ 1, 2]
+!             i=2 R=1 (  2*    0  )   ! index_hamiltonian(:,1,2) = [ 0,-1]
+!             i=1 R=2 (  0     3  )   ! index_hamiltonian(:,2,1) = [ 3, 3]
+!             i=2 R=2 (  0     4  )   ! index_hamiltonian(:,2,2) = [ 4, 4]
+!             i=1 R=3 (  0     0  )   ! index_hamiltonian(:,3,1) = [ 0,-1]
+!             i=2 R=3 (  3*    4' )   ! index_hamiltoniah(:,3,2) = [ 5, 5]
+!             hamiltonian              = [1, 2, 3, 4, 4']  # values
+!             column_index_hamiltonian = [1, 2, 2, 2, 2]  # corresponding j
+!             ! 2* and 3* are not stored because of symmetry [only 'U' stored]
+!             ! 4  and 4' are equal because of symmetry but both stored.
+!
+!           Looping then looks like this:
+!
+!           do i_cell_row = 1, n_cells_in_hamiltonian-1   ! yes, "-1".
+!             do i_basis_row = 1, n_basis
+!               i_index_first = index_hamiltonian(1, i_cell_row, i_basis_row)
+!               i_index_last = index_hamiltonian(2, i_cell_row, i_basis_row)
+!               do i_index = i_index_first, i_index_last
+!                 i_basis_col = column_index_hamiltonian(i_index)
+!                 ! Use:
+!                 !    hamiltonian(i_index, i_spin)
+!                 !    density_matrix_sparse(i_index)
+!                 !    and i_basis_row, i_cell_row, i_basis_col
+!                 ! or any combination of
+!                 !    (i_basis_row, i_loc_cell_row), &
+!                 !    & (i_basis_col, i_loc_cell_col),
+!                 ! with
+!                 !    i_cell_row == &
+!                 !    & position_in_hamiltonian(i_loc_cell_row, i_loc_cell_col)
+!               end do
+!             end do
+!           end do
+!
+!
+!           Just a few remarks:
+!            * I (JW) would have named
+!               + index_hamiltonian        -> row2index
+!               + column_index_hamiltonian -> index2col
+!              because the former specifies a range of indices for a given row
+!              consisting of i_basis_row and i_cell_row.  The latter gives
+!              the column (i_basis_col, as i_cell_col=0) for a given index.
+!            * It is kind of unconventional in fortran that the fast index
+!              corresponds to the column instead of the row.
+
+basis ref:
+    do i_basis = 1, n_basis, 1
+      i_fn = basis_fn(i_basis)
+
+      write(info_str,'(I5,1X,A8,1X,I3,1X,I3,1X,I3,1X,I3)') &
+        i_basis, basisfn_type(i_fn), &
+        basis_atom(i_basis), basisfn_n(i_fn), basis_l(i_basis), &
+        basis_m(i_basis)
+        !   fn.   type   at.   n   l   m
+      call localorb_info(info_str,50,'(A)')
+
+    enddo
+
+    phase:
+        (-1)**logical_and(m>0, m%2==1)
+    order: from m=-l to m=+l (wikipedia real spherical harmonics: https://en.wikipedia.org/wiki/Table_of_spherical_harmonics)
+*/
+}
+
+/*
+ * Hash Map Structure to quickly look up DeepH Atom Pairs
+ * Key: (R1, R2, R3, atom_i, atom_j)
+ * Value: index in atom_pairs array
+ */
+typedef struct {
+    int key[5];
+    int value; // -1 if empty
+} HashEntry;
+
+typedef struct {
+    HashEntry* entries;
+    size_t size;
+} HashMap;
+
+// Simple mixing hash function for 5 integers
+uint64_t hash_func(const int* key, size_t size) {
+    uint64_t hash = 14695981039346656037UL;
+    for (size_t i = 0; i < 5; ++i) {
+        hash ^= (uint64_t)(key[i]);
+        hash *= 1099511628211UL;
+    }
+    return hash % size;
+}
+
+HashMap* create_hash_map(size_t n_pairs) {
+    // Load factor ~0.7
+    size_t size = (size_t)(n_pairs * 1.5) + 7;
+    HashMap* map = (HashMap*)malloc(sizeof(HashMap));
+    map->entries = (HashEntry*)malloc(sizeof(HashEntry) * size);
+    map->size = size;
+    for (size_t i = 0; i < size; ++i) {
+        map->entries[i].value = -1;
+    }
+    return map;
+}
+
+void free_hash_map(HashMap* map) {
+    if (map) {
+        if (map->entries) free(map->entries);
+        free(map);
+    }
+}
+
+void map_insert(HashMap* map, const int* key5, int value) {
+    uint64_t idx = hash_func(key5, map->size);
+    while (map->entries[idx].value != -1) {
+        // Linear probing
+        int match = 1;
+        for(int k=0; k<5; k++) if(map->entries[idx].key[k] != key5[k]) match = 0;
+        if (match) {
+            // Already exists, update implementation (should not happen for unique pairs)
+            return;
+        }
+        idx = (idx + 1) % map->size;
+    }
+    // Found empty slot
+    for(int k=0; k<5; k++) map->entries[idx].key[k] = key5[k];
+    map->entries[idx].value = value;
+}
+
+int map_get(HashMap* map, const int* key5) {
+    uint64_t idx = hash_func(key5, map->size);
+    while (map->entries[idx].value != -1) {
+        int match = 1;
+        for(int k=0; k<5; k++) if(map->entries[idx].key[k] != key5[k]) match = 0;
+        if (match) {
+            return map->entries[idx].value;
+        }
+        idx = (idx + 1) % map->size;
+    }
+    return -1; // Not found
+}
+
+/* ===================================================================== */
+/*                         Reverse (DeepH -> aims)                       */
+/* ===================================================================== */
+
+typedef struct {
+    int *atom_pairs;          /* (n_pairs,5) */
+    int *chunk_boundaries;    /* (n_pairs+1) */
+    int *chunk_shapes;        /* (n_pairs,2) */
+    double *entries;          /* flattened entries */
+    int n_pairs;
+    int n_entries;
+} deeph_matrix_t;
+
+static void free_deeph_matrix(deeph_matrix_t *mx) {
+    if(!mx) return;
+    free(mx->atom_pairs);
+    free(mx->chunk_boundaries);
+    free(mx->chunk_shapes);
+    free(mx->entries);
+    mx->atom_pairs = NULL;
+    mx->chunk_boundaries = NULL;
+    mx->chunk_shapes = NULL;
+    mx->entries = NULL;
+}
+
+static int read_int_dataset(hid_t file, const char *name, int **out_data, hsize_t *out_len) {
+    hid_t dset = H5Dopen(file, name, H5P_DEFAULT);
+    if(dset < 0) return -1;
+    hid_t space = H5Dget_space(dset);
+    int ndims = H5Sget_simple_extent_ndims(space);
+    hsize_t dims[4] = {0};
+    H5Sget_simple_extent_dims(space, dims, NULL);
+    hsize_t total = 1;
+    for(int i=0;i<ndims;i++) total *= dims[i];
+    int *buf = (int*)malloc(sizeof(int)*total);
+    if(!buf) { H5Sclose(space); H5Dclose(dset); return -2; }
+    herr_t st = H5Dread(dset, H5T_NATIVE_INT, H5S_ALL, H5S_ALL, H5P_DEFAULT, buf);
+    H5Sclose(space);
+    H5Dclose(dset);
+    if(st < 0) { free(buf); return -3; }
+    *out_data = buf;
+    if(out_len) *out_len = total;
+    return 0;
+}
+
+static int read_double_dataset(hid_t file, const char *name, double **out_data, hsize_t *out_len) {
+    hid_t dset = H5Dopen(file, name, H5P_DEFAULT);
+    if(dset < 0) return -1;
+    hid_t space = H5Dget_space(dset);
+    int ndims = H5Sget_simple_extent_ndims(space);
+    hsize_t dims[4] = {0};
+    H5Sget_simple_extent_dims(space, dims, NULL);
+    hsize_t total = 1;
+    for(int i=0;i<ndims;i++) total *= dims[i];
+    double *buf = (double*)malloc(sizeof(double)*total);
+    if(!buf) { H5Sclose(space); H5Dclose(dset); return -2; }
+    herr_t st = H5Dread(dset, H5T_NATIVE_DOUBLE, H5S_ALL, H5S_ALL, H5P_DEFAULT, buf);
+    H5Sclose(space);
+    H5Dclose(dset);
+    if(st < 0) { free(buf); return -3; }
+    *out_data = buf;
+    if(out_len) *out_len = total;
+    return 0;
+}
+
+typedef struct {
+    double re;
+    double im;
+} deeph_complex_t;
+
+static int read_entries_dataset(hid_t file, const char *name, double **out_data, hsize_t *out_len) {
+    hid_t dset = H5Dopen(file, name, H5P_DEFAULT);
+    if(dset < 0) return -1;
+
+    hid_t space = H5Dget_space(dset);
+    int ndims = H5Sget_simple_extent_ndims(space);
+    hsize_t dims[4] = {0};
+    H5Sget_simple_extent_dims(space, dims, NULL);
+    hsize_t total = 1;
+    for(int i=0;i<ndims;i++) total *= dims[i];
+
+    hid_t dtype = H5Dget_type(dset);
+    H5T_class_t cls = H5Tget_class(dtype);
+
+    double *buf = (double*)malloc(sizeof(double)*total);
+    if(!buf) {
+        H5Tclose(dtype);
+        H5Sclose(space);
+        H5Dclose(dset);
+        return -2;
+    }
+
+    if(cls == H5T_FLOAT) {
+        herr_t st = H5Dread(dset, H5T_NATIVE_DOUBLE, H5S_ALL, H5S_ALL, H5P_DEFAULT, buf);
+        if(st < 0) {
+            free(buf);
+            H5Tclose(dtype);
+            H5Sclose(space);
+            H5Dclose(dset);
+            return -3;
+        }
+    } else if(cls == H5T_COMPOUND && H5Tget_nmembers(dtype) == 2) {
+        hid_t memtype = H5Tcreate(H5T_COMPOUND, sizeof(deeph_complex_t));
+        char *m0 = H5Tget_member_name(dtype, 0);
+        char *m1 = H5Tget_member_name(dtype, 1);
+        if(!m0 || !m1) {
+            if(m0) H5free_memory(m0);
+            if(m1) H5free_memory(m1);
+            H5Tclose(memtype);
+            free(buf);
+            H5Tclose(dtype);
+            H5Sclose(space);
+            H5Dclose(dset);
+            return -4;
+        }
+
+        H5Tinsert(memtype, m0, offsetof(deeph_complex_t, re), H5T_NATIVE_DOUBLE);
+        H5Tinsert(memtype, m1, offsetof(deeph_complex_t, im), H5T_NATIVE_DOUBLE);
+
+        deeph_complex_t *cbuf = (deeph_complex_t*)malloc(sizeof(deeph_complex_t)*total);
+        if(!cbuf) {
+            H5free_memory(m0);
+            H5free_memory(m1);
+            H5Tclose(memtype);
+            free(buf);
+            H5Tclose(dtype);
+            H5Sclose(space);
+            H5Dclose(dset);
+            return -5;
+        }
+
+        herr_t st = H5Dread(dset, memtype, H5S_ALL, H5S_ALL, H5P_DEFAULT, cbuf);
+        H5free_memory(m0);
+        H5free_memory(m1);
+        H5Tclose(memtype);
+        if(st < 0) {
+            free(cbuf);
+            free(buf);
+            H5Tclose(dtype);
+            H5Sclose(space);
+            H5Dclose(dset);
+            return -6;
+        }
+
+        for(hsize_t i=0; i<total; ++i) {
+            buf[i] = cbuf[i].re;
+        }
+        free(cbuf);
+    } else {
+        free(buf);
+        H5Tclose(dtype);
+        H5Sclose(space);
+        H5Dclose(dset);
+        return -7;
+    }
+
+    H5Tclose(dtype);
+    H5Sclose(space);
+    H5Dclose(dset);
+
+    *out_data = buf;
+    if(out_len) *out_len = total;
+    return 0;
+}
+
+/* Read DeepH matrix (H or S) */
+static int load_deeph_matrix(const char *filepath, deeph_matrix_t *mx) {
+    hid_t file = H5Fopen(filepath, H5F_ACC_RDONLY, H5P_DEFAULT);
+    if(file < 0) return -1;
+    hsize_t len = 0;
+    int rc = 0;
+    rc |= read_int_dataset(file, "atom_pairs", &mx->atom_pairs, &len);
+    if(rc) { H5Fclose(file); return -2; }
+    mx->n_pairs = (int)(len/5);
+    rc |= read_int_dataset(file, "chunk_boundaries", &mx->chunk_boundaries, &len);
+    rc |= read_int_dataset(file, "chunk_shapes", &mx->chunk_shapes, &len);
+    rc |= read_entries_dataset(file, "entries", &mx->entries, &len);
+    mx->n_entries = (int)len;
+    H5Fclose(file);
+    if(rc) return rc;
+
+    if(!mx->atom_pairs || !mx->chunk_boundaries || !mx->chunk_shapes || !mx->entries) return -4;
+    if(mx->n_pairs <= 0) return -5;
+    if(mx->chunk_boundaries[0] != 0) return -6;
+    if(mx->chunk_boundaries[mx->n_pairs] != mx->n_entries) return -7;
+
+    for(int i=0; i<mx->n_pairs; ++i) {
+        int b0 = mx->chunk_boundaries[i];
+        int b1 = mx->chunk_boundaries[i+1];
+        int nr = mx->chunk_shapes[i * 2 + 0];
+        int nc = mx->chunk_shapes[i * 2 + 1];
+        if(b0 < 0 || b1 < b0 || b1 > mx->n_entries) return -8;
+        if(nr <= 0 || nc <= 0) return -9;
+        if((long long)nr * (long long)nc != (long long)(b1 - b0)) return -10;
+    }
+    return rc;
+}
+
+static int validate_pair_shapes(const deeph_matrix_t *mx, const int *orbit_per_atom, int n_atoms, int spinful) {
+    if(!mx || !orbit_per_atom || n_atoms <= 0) return -11;
+
+    int factor = spinful ? 2 : 1;
+    for(int i = 0; i < mx->n_pairs; ++i) {
+        int ai = mx->atom_pairs[i * 5 + 3];
+        int aj = mx->atom_pairs[i * 5 + 4];
+        if(ai < 0 || ai >= n_atoms || aj < 0 || aj >= n_atoms) return -12;
+
+        int expect_rows = factor * orbit_per_atom[ai];
+        int expect_cols = factor * orbit_per_atom[aj];
+        int got_rows = mx->chunk_shapes[i * 2 + 0];
+        int got_cols = mx->chunk_shapes[i * 2 + 1];
+        if(got_rows != expect_rows || got_cols != expect_cols) return -13;
+    }
+
+    return 0;
+}
+
+/* --------------------------------------------------------------------- */
+/* Hash map (key=R1,R2,R3,ai,aj) */
+static int cmp_int(const void *a, const void *b){
+    int ia = *(const int*)a;
+    int ib = *(const int*)b;
+    if(ia<ib) return -1; if(ia>ib) return 1; return 0;
+}
+
+/* Build atom permutation: replicate aims_to_deeph.py ordering (stable sort by chemical symbol) */
+static const char* atomic_symbol_from_Z(int z){
+    /* minimal table up to 118 */
+    static const char* tbl[] = {
+        "", "H","He","Li","Be","B","C","N","O","F","Ne",
+        "Na","Mg","Al","Si","P","S","Cl","Ar",
+        "K","Ca","Sc","Ti","V","Cr","Mn","Fe","Co","Ni","Cu","Zn",
+        "Ga","Ge","As","Se","Br","Kr",
+        "Rb","Sr","Y","Zr","Nb","Mo","Tc","Ru","Rh","Pd","Ag","Cd",
+        "In","Sn","Sb","Te","I","Xe",
+        "Cs","Ba","La","Ce","Pr","Nd","Pm","Sm","Eu","Gd","Tb","Dy","Ho","Er","Tm","Yb","Lu",
+        "Hf","Ta","W","Re","Os","Ir","Pt","Au","Hg",
+        "Tl","Pb","Bi","Po","At","Rn",
+        "Fr","Ra","Ac","Th","Pa","U","Np","Pu","Am","Cm","Bk","Cf","Es","Fm","Md","No","Lr",
+        "Rf","Db","Sg","Bh","Hs","Mt","Ds","Rg","Cn","Nh","Fl","Mc","Lv","Ts","Og"
+    };
+    if(z<0 || z >= (int)(sizeof(tbl)/sizeof(tbl[0]))) return "";
+    return tbl[z];
+}
+
+/* Map aims basisfn_type integer to the forward BASIS_TYPE_ORDER: ionic(0) < atomic(1) < hydro(2). 
+ * If unknown code, fall back to 1 (atomic) to preserve mid ordering. */
+
+static void build_atom_permutation(int n_atoms, const int *atom_Z, int *old2new, int *new2old) {
+    int *idx = (int*)malloc(sizeof(int)*n_atoms);
+    for(int i=0;i<n_atoms;i++) idx[i]=i;
+    /* stable sort by symbol lexicographic, fallback to Z then index */
+    for(int i=0;i<n_atoms-1;i++){
+        for(int j=i+1;j<n_atoms;j++){
+            const char* si = atomic_symbol_from_Z(atom_Z[idx[i]]);
+            const char* sj = atomic_symbol_from_Z(atom_Z[idx[j]]);
+            int cmp = strcmp(si, sj);
+            if(cmp > 0 || (cmp==0 && atom_Z[idx[i]] > atom_Z[idx[j]]) || (cmp==0 && atom_Z[idx[i]]==atom_Z[idx[j]] && idx[i] > idx[j])) {
+                int tmp=idx[i]; idx[i]=idx[j]; idx[j]=tmp;
+            }
+        }
+    }
+    for(int newi=0; newi<n_atoms; newi++){
+        int oldi = idx[newi];
+        old2new[oldi] = newi;
+        new2old[newi] = oldi;
+    }
+    free(idx);
+}
+
+/* Map aims basisfn_type integer to the forward BASIS_TYPE_ORDER: ionic(0) < atomic(1) < hydro(2).
+ * Typical encodings in aims: 2=ionic, 1=atomic, 3=hydro/confined. Unknown codes are treated as
+ * atomic to stay in the middle of the ordering.
+ */
+static int basis_type_rank(int type_code){
+    switch(type_code){
+        case 2: return 0; /* ionic */
+        case 1: return 1; /* atomic */
+        case 3: return 2; /* hydro / confined */
+        case 0: return 1; /* also atomic in some sets */
+        default: return 1; /* treat unknown as atomic */
+    }
+}
+
+typedef struct {
+    int l, n, atom_new, m, type_rank;
+    int aims_idx; /* 0-based */
+} basis_item_t;
+
+static int cmp_basis_item(const void *a, const void *b){
+    const basis_item_t *x = (const basis_item_t*)a;
+    const basis_item_t *y = (const basis_item_t*)b;
+    /*
+     * Keep the original AIMS basis traversal order.
+     * Forward aims_to_deeph now disables orbital sorting and uses the
+     * native per-atom orbital order directly.
+     */
+    if(x->aims_idx != y->aims_idx) return (x->aims_idx < y->aims_idx) ? -1 : 1;
+    return 0;
+}
+
+/* Build mapping from aims basis -> deeph basis order */
+static void build_basis_maps(int n_basis, int n_atoms,
+    const int *basis_fn, const int *basis_atom, const int *basisfn_n, const int *basis_l, const int *basis_m,
+    const int *basisfn_type, const int *atom_old2new,
+    int *basis_deeph_index, int *basis_atom_new, int *basis_subidx, int *orbit_per_atom)
+{
+    basis_item_t *items = (basis_item_t*)malloc(sizeof(basis_item_t)*n_basis);
+    for(int i=0;i<n_basis;i++) {
+        int atom_old = basis_atom[i]-1; /* aims passes 1-based */
+        items[i].l = basis_l[i];
+        int fn_idx = basis_fn ? (basis_fn[i]-1) : -1;
+        items[i].n = (basisfn_n && fn_idx>=0) ? basisfn_n[fn_idx] : 0;
+        items[i].atom_new = atom_old>=0 ? atom_old2new[atom_old] : atom_old;
+        items[i].m = basis_m[i];
+        int type_code = (basisfn_type && fn_idx>=0) ? basisfn_type[fn_idx] : 0;
+        items[i].type_rank = basis_type_rank(type_code);
+        items[i].aims_idx = i;
+    }
+    qsort(items, n_basis, sizeof(basis_item_t), cmp_basis_item);
+
+    /* count per-atom and assign subidx */
+    for(int i=0;i<n_atoms;i++) orbit_per_atom[i]=0;
+    for(int newidx=0; newidx<n_basis; newidx++) {
+        int aims_idx = items[newidx].aims_idx;
+        int atom_new = items[newidx].atom_new;
+        int sub = orbit_per_atom[atom_new];
+        orbit_per_atom[atom_new]++;
+        basis_deeph_index[aims_idx] = newidx;
+        basis_atom_new[aims_idx] = atom_new;
+        basis_subidx[aims_idx] = sub;
+    }
+    free(items);
+}
+
+/* Convert DeepH -> aims for single-spin matrix */
+static void convert_deeph_to_aims_single(
+    double* out_aims_entries,
+    const deeph_matrix_t *mx,
+    int n_cells,
+    int n_basis,
+    int n_ham_size,
+    const int* cell_indices,
+    const int* start_idx_mx,
+    const int* end_idx_mx,
+    const int* col_idx_mx,
+    const int* basis_atom_new,
+    const int* basis_subidx,
+    const int* phase_factors,
+    double unit_conv
+) {
+    HashMap* map = create_hash_map(mx->n_pairs);
+    for (int i = 0; i < mx->n_pairs; ++i) {
+        const int* current_key = &mx->atom_pairs[i * 5];
+        map_insert(map, current_key, i);
+    }
+
+    /* index_hamiltonian is (2, n_cells, n_basis)
+     * idx_start points to index_hamiltonian(1,1,1). Stride is 2.
+     * idx_end points to index_hamiltonian(2,1,1). Stride is 2.
+     * BUT wait, we are passing &index_hamiltonian(2,1,1) as idx_end.
+     * So idx_end[0] is index_hamiltonian(2,1,1).
+     * And likely idx_end[2] is index_hamiltonian(2,2,1).
+     */
+
+    int n_cells_loop = (n_cells > 0) ? (n_cells - 1) : 0;
+    
+    #pragma omp parallel for schedule(dynamic)
+    for (int ic = 0; ic < n_cells_loop; ++ic) {
+        int R[3];
+        /*
+         * Forward aims_to_deeph exports atom_pairs with negated cell vectors:
+         *   R_deeph = -R_aims
+         * Match that convention here when querying DeepH pair keys.
+         */
+        R[0] = -cell_indices[ic + 0 * n_cells];
+        R[1] = -cell_indices[ic + 1 * n_cells];
+        R[2] = -cell_indices[ic + 2 * n_cells];
+
+        for (int ib_row = 0; ib_row < n_basis; ++ib_row) {
+            int if_idx = ic + ib_row * n_cells;
+            
+            /* Check strides carefully. 
+               Fortran: index_hamiltonian(2, n_cells, n_basis)
+               C linear index for (1, ic, ib) = (0) + (ic)*2 + (ib)*2*n_cells
+               So yes, stride is 2.
+            */
+            int start = start_idx_mx[2 * if_idx] - 1; 
+            
+            /* For idx_end, we passed address of index_hamiltonian(2,1,1).
+               Relative layout:
+               (1,1,1) -> start[0]
+               (2,1,1) -> start[1] == end[0]
+               (1,2,1) -> start[2]
+               (2,2,1) -> start[3] == end[2]
+               So end_idx_mx[2 * if_idx] corresponds to (2, ic, ib) relative to (2,1,1).
+               (2, ic, ib) relative to (1,1,1) is 1 + ic*2 + ib*2*n_cells.
+               (2, ic, ib) relative to (2,1,1) is (ic*2 + ib*2*n_cells).
+               So yes, end_idx_mx[2 * if_idx] is correct.
+            */
+            int end   = end_idx_mx[2 * if_idx]   - 1;
+
+            if(start < 0 || end < start) continue;
+
+            int atom_i = basis_atom_new[ib_row];
+            int orb_i  = basis_subidx[ib_row];
+            int phase_i = phase_factors[ib_row];
+
+            for (int k = start; k <= end; ++k) {
+                if (k < 0 || k >= n_ham_size) continue;
+                int ib_col = col_idx_mx[k] - 1; /* Fortran 1-based */
+                if(ib_col < 0 || ib_col >= n_basis) continue;
+
+                int atom_j = basis_atom_new[ib_col];
+                int orb_j  = basis_subidx[ib_col];
+                int phase_j = phase_factors[ib_col];
+
+                int search_key[5] = {R[0], R[1], R[2], atom_i, atom_j};
+                int pair_idx = map_get(map, search_key);
+
+                double val = 0.0;
+
+                if (pair_idx != -1) {
+                    int bound_start = mx->chunk_boundaries[pair_idx];
+                    int n_row_block = mx->chunk_shapes[pair_idx * 2 + 0];
+                    int n_col_block = mx->chunk_shapes[pair_idx * 2 + 1];
+                    if (orb_i >= 0 && orb_j >= 0 && orb_i < n_row_block && orb_j < n_col_block) {
+                         int val_offset = bound_start + (orb_i * n_col_block + orb_j);
+                         if (val_offset >= 0 && val_offset < mx->n_entries) {
+                             val = mx->entries[val_offset];
+                         }
+                    }
+                } else {
+                    int rev_key[5] = {-R[0], -R[1], -R[2], atom_j, atom_i};
+                    int rev_pair_idx = map_get(map, rev_key);
+                    if (rev_pair_idx != -1) {
+                        int bound_start = mx->chunk_boundaries[rev_pair_idx];
+                        int n_row_block = mx->chunk_shapes[rev_pair_idx * 2 + 0];
+                        int n_col_block = mx->chunk_shapes[rev_pair_idx * 2 + 1];
+                        if (orb_j >= 0 && orb_i >= 0 && orb_j < n_row_block && orb_i < n_col_block) {
+                            int val_offset = bound_start + (orb_j * n_col_block + orb_i);
+                            if (val_offset >= 0 && val_offset < mx->n_entries) {
+                                val = mx->entries[val_offset];
+                            }
+                        }
+                    } else {
+                        val = 0.0;
+                    }
+                }
+
+                if (phase_i == -1) val = -val;
+                if (phase_j == -1) val = -val;
+
+                out_aims_entries[k] = val * unit_conv;
+            }
+        }
+    }
+
+    free_hash_map(map);
+}
+
+/* Spinful: split 2N x 2N block into up/down */
+static void convert_deeph_to_aims_spinful(
+    double* out_up,
+    double* out_dn,
+    const deeph_matrix_t *mx,
+    int n_cells,
+    int n_basis,
+    int n_ham_size,
+    const int* cell_indices,
+    const int* start_idx_mx,
+    const int* end_idx_mx,
+    const int* col_idx_mx,
+    const int* basis_atom_new,
+    const int* basis_subidx,
+    const int* phase_factors,
+    double unit_conv
+) {
+    HashMap* map = create_hash_map(mx->n_pairs);
+    for (int i = 0; i < mx->n_pairs; ++i) {
+        const int* current_key = &mx->atom_pairs[i * 5];
+        map_insert(map, current_key, i);
+    }
+
+    int n_cells_loop = (n_cells > 0) ? (n_cells - 1) : 0;
+    
+    #ifdef _OPENMP
+    #pragma omp parallel for schedule(dynamic)
+    #endif
+    for (int ic = 0; ic < n_cells_loop; ++ic) {
+        int R[3];
+        /* Keep cell-vector sign consistent with forward export convention. */
+        R[0] = -cell_indices[ic + 0 * n_cells];
+        R[1] = -cell_indices[ic + 1 * n_cells];
+        R[2] = -cell_indices[ic + 2 * n_cells];
+
+        for (int ib_row = 0; ib_row < n_basis; ++ib_row) {
+            int if_idx = ic + ib_row * n_cells;
+            int start = start_idx_mx[2 * if_idx] - 1;
+            int end   = end_idx_mx[2 * if_idx]   - 1;
+            if(start < 0 || end < start) continue;
+
+            int atom_i = basis_atom_new[ib_row];
+            int orb_i  = basis_subidx[ib_row];
+            int phase_i = phase_factors[ib_row];
+
+            for (int k = start; k <= end; ++k) {
+                if (k < 0 || k >= n_ham_size) continue;
+                int ib_col = col_idx_mx[k] - 1;
+                if(ib_col < 0 || ib_col >= n_basis) continue;
+
+                int atom_j = basis_atom_new[ib_col];
+                int orb_j  = basis_subidx[ib_col];
+                int phase_j = phase_factors[ib_col];
+
+                int search_key[5] = {R[0], R[1], R[2], atom_i, atom_j};
+                int pair_idx = map_get(map, search_key);
+
+                double val_up = 0.0;
+                double val_dn = 0.0;
+
+                if (pair_idx != -1) {
+                    int bound_start = mx->chunk_boundaries[pair_idx];
+                    int n_row_block = mx->chunk_shapes[pair_idx * 2 + 0];
+                    int n_col_block = mx->chunk_shapes[pair_idx * 2 + 1];
+                    if ((n_row_block % 2) != 0 || (n_col_block % 2) != 0) {
+                        out_up[k] = 0.0;
+                        out_dn[k] = 0.0;
+                        continue;
+                    }
+                    int n_row_spin = n_row_block / 2;
+                    int n_col_spin = n_col_block / 2;
+                    int val_offset_base = bound_start;
+
+                    if (orb_i >= 0 && orb_j >= 0 && orb_i < n_row_spin && orb_j < n_col_spin) {
+                        /* Up-Up */
+                        int off_up = val_offset_base + (orb_i * n_col_block + orb_j);
+                        /* Dn-Dn: lower-right block */
+                        int off_dn = val_offset_base + ((orb_i + n_row_spin) * n_col_block + (orb_j + n_col_spin));
+                        if (off_up >= 0 && off_up < mx->n_entries) val_up = mx->entries[off_up];
+                        if (off_dn >= 0 && off_dn < mx->n_entries) val_dn = mx->entries[off_dn];
+                    }
+
+                } else {
+                    int rev_key[5] = {-R[0], -R[1], -R[2], atom_j, atom_i};
+                    int rev_pair_idx = map_get(map, rev_key);
+                    if (rev_pair_idx != -1) {
+                        int bound_start = mx->chunk_boundaries[rev_pair_idx];
+                        int n_row_block = mx->chunk_shapes[rev_pair_idx * 2 + 0];
+                        int n_col_block = mx->chunk_shapes[rev_pair_idx * 2 + 1];
+                        if ((n_row_block % 2) != 0 || (n_col_block % 2) != 0) {
+                            out_up[k] = 0.0;
+                            out_dn[k] = 0.0;
+                            continue;
+                        }
+                        int n_row_spin = n_row_block / 2;
+                        int n_col_spin = n_col_block / 2;
+                        int val_offset_base = bound_start;
+                        
+                        if (orb_j >= 0 && orb_i >= 0 && orb_j < n_row_spin && orb_i < n_col_spin) {
+                            int off_up = val_offset_base + (orb_j * n_col_block + orb_i);
+                            int off_dn = val_offset_base + ((orb_j + n_row_spin) * n_col_block + (orb_i + n_col_spin));
+                            if (off_up >= 0 && off_up < mx->n_entries) val_up = mx->entries[off_up];
+                            if (off_dn >= 0 && off_dn < mx->n_entries) val_dn = mx->entries[off_dn];
+                        }
+                    } else {
+                        val_up = 0.0; val_dn = 0.0;
+                    }
+                }
+
+                if (phase_i == -1) { val_up = -val_up; val_dn = -val_dn; }
+                if (phase_j == -1) { val_up = -val_up; val_dn = -val_dn; }
+
+                out_up[k] = val_up * unit_conv;
+                out_dn[k] = val_dn * unit_conv;
+            }
+        }
+    }
+
+    free_hash_map(map);
+}
+
+/* Public entry: returns 0 on success */
+int deeph_load_and_map_c(
+    const char *deeph_dir,
+    int n_atoms,
+    int n_basis,
+    int n_spin,
+    int n_cells,
+    int n_ham_size,
+    const int *cell_index,          /* (n_cells,3) Fortran layout */
+    const int *idx_start,           /* index_hamiltonian(1,:,:) shape (n_cells,n_basis) */
+    const int *idx_end,             /* index_hamiltonian(2,:,:) */
+    const int *col_index,           /* column_index_hamiltonian */
+    const int *basis_fn,            /* basis_fn(i_basis), 1-based */
+    const int *basis_atom,          /* length n_basis, 1-based atoms */
+    const int *basisfn_n,
+    const int *basis_l,
+    const int *basis_m,
+    const int *basisfn_type,        /* basisfn_type(i_fn), 1-based */
+    const int *atom_Z,              /* length n_atoms */
+    double *ham_out                 /* length n_ham_size * n_spin */
+) {
+    /* 1. read DeepH files */
+    char path_h_alt[1024];
+    snprintf(path_h_alt, sizeof(path_h_alt), "%s/hamiltonian.h5", deeph_dir);
+
+    deeph_matrix_t mx_h = {0};
+    
+    if(load_deeph_matrix(path_h_alt, &mx_h) != 0) {
+        fprintf(stderr, "Failed to read %s \n", path_h_alt);
+        return -1;
+    }
+    
+
+    /* 2. atom permutation */
+    int *old2new = (int*)malloc(sizeof(int)*n_atoms);
+    int *new2old = (int*)malloc(sizeof(int)*n_atoms);
+    build_atom_permutation(n_atoms, atom_Z, old2new, new2old);
+
+    /* 3. basis mapping */
+    int *basis_deeph_index = (int*)malloc(sizeof(int)*n_basis);
+    int *basis_atom_new    = (int*)malloc(sizeof(int)*n_basis);
+    int *basis_subidx      = (int*)malloc(sizeof(int)*n_basis);
+    int *orbit_per_atom    = (int*)malloc(sizeof(int)*n_atoms);
+    build_basis_maps(n_basis, n_atoms, basis_fn, basis_atom, basisfn_n, basis_l, basis_m, basisfn_type, old2new,
+        basis_deeph_index, basis_atom_new, basis_subidx, orbit_per_atom);
+
+    {
+        int v_h = validate_pair_shapes(&mx_h, orbit_per_atom, n_atoms, (n_spin == 2));
+        if(v_h != 0) {
+            free_deeph_matrix(&mx_h);
+            free(old2new); free(new2old); free(basis_deeph_index); free(basis_atom_new); free(basis_subidx); free(orbit_per_atom);
+            return v_h;
+        }
+    }
+
+    /* 4. phase factors */
+    int *phase = (int*)malloc(sizeof(int)*n_basis);
+    for(int i=0;i<n_basis;i++) {
+        int m = basis_m[i];
+        int neg = (m>0 && (m%2)!=0);
+        phase[i] = neg ? -1 : 1;
+    }
+
+    /* 5. map Hamiltonian */
+    double ev2hartree = 1.0 / 27.2113845;
+    if(n_spin == 1) {
+        convert_deeph_to_aims_single(ham_out, &mx_h, n_cells, n_basis, n_ham_size,
+            cell_index, idx_start, idx_end, col_index, basis_atom_new, basis_subidx, phase, ev2hartree);
+    } else if(n_spin == 2) {
+        convert_deeph_to_aims_spinful(ham_out, ham_out + n_ham_size, &mx_h, n_cells, n_basis, n_ham_size,
+            cell_index, idx_start, idx_end, col_index, basis_atom_new, basis_subidx, phase, ev2hartree);
+    }
+
+    /* cleanup */
+    free_deeph_matrix(&mx_h);
+    free(old2new); free(new2old); free(basis_deeph_index); free(basis_atom_new); free(basis_subidx); free(orbit_per_atom); free(phase);
+
+    return 0;
+}
+
