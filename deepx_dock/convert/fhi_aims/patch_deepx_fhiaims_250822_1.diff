+  logical function deeph_try_load_hamiltonian(hamiltonian)
+    real*8, dimension(n_hamiltonian_matrix_size, n_spin), intent(inout) :: hamiltonian
+
+    integer :: i_fn
+    integer :: i_atom
+    integer(c_int) :: ierr_deeph
+    integer(c_int), allocatable :: basisfn_type_i(:)
+    integer(c_int), allocatable :: atom_z_i(:)
+    integer(c_int), allocatable :: idx_ham_flat(:)
+    character(len=200) :: info_str
+
+    deeph_try_load_hamiltonian = .false.
+
+    ! 如果用户没有启用 warmstart，直接返回
+    if (.not. use_deepx_warmstart) then
+      return
+    end if
+
+    allocate(basisfn_type_i(n_basis_fns))
+    allocate(atom_z_i(n_atoms))
+
+    do i_fn = 1, n_basis_fns
+      select case (trim(adjustl(basisfn_type(i_fn))))
+      case ('ionic')
+        basisfn_type_i(i_fn) = 2_c_int
+      case ('atomic')
+        basisfn_type_i(i_fn) = 1_c_int
+      case ('hydro', 'confined')
+        basisfn_type_i(i_fn) = 3_c_int
+      case default
+        basisfn_type_i(i_fn) = 1_c_int
+      end select
+    end do
+
+    do i_atom = 1, n_atoms
+      atom_z_i(i_atom) = int(nint(species_z(species(i_atom))), c_int)
+    end do
+
+    allocate(idx_ham_flat(2 * n_cells_in_hamiltonian * n_basis))
+    idx_ham_flat = reshape(index_hamiltonian, [2 * n_cells_in_hamiltonian * n_basis])
+
+    ierr_deeph = deeph_try_load_autodetect_c(merge(1_c_int, 0_c_int, use_local_index), int(n_atoms, c_int), int(n_basis, c_int), int(n_spin, c_int), &
+      int(n_cells_in_hamiltonian, c_int), int(n_hamiltonian_matrix_size, c_int), &
+      cell_index, idx_ham_flat, idx_ham_flat(2:), column_index_hamiltonian, &
+      basis_fn, basis_atom, basisfn_n, basis_l, basis_m, basisfn_type_i, atom_z_i, hamiltonian)
+
+    deallocate(idx_ham_flat)
+    deallocate(basisfn_type_i)
+    deallocate(atom_z_i)
+
+    if (ierr_deeph == 0_c_int) then
+      deeph_try_load_hamiltonian = .true.
+      write(info_str,'(A)') 'DeepX restart: loaded real-space Hamiltonian from ./deepx_warm or ./deeph_warm.'
+      call localorb_info(info_str,use_unit,'(A)')
+    else if (ierr_deeph == 2_c_int) then
+      write(info_str,'(A)') '*** FATAL ERROR: use_deepx_warmstart is .true. but use_local_index is active (not supported).'
+      call localorb_info(info_str,use_unit,'(A)')
+      call aims_stop('use_deepx_warmstart requires use_local_index to be .false.', 'deeph_try_load_hamiltonian')
+    else if (ierr_deeph == 1_c_int) then
+      ! Do not found warm dir - Fatal ERROR
+      write(info_str,'(A)') '*** FATAL ERROR: use_deepx_warmstart is .true. but ./deepx_warm or ./deeph_warm directories not found.'
+      call localorb_info(info_str,use_unit,'(A)')
+      call aims_stop('use_deepx_warmstart is .true. but warm directory not found. Please create ./deepx_warm or ./deeph_warm.', 'deeph_try_load_hamiltonian')
+    else
+      write(info_str,'(A,I0,A)') '*** FATAL ERROR: DeepX restart failed (ierr=', ierr_deeph, ').'
+      call localorb_info(info_str,use_unit,'(A)')
+      call aims_stop('use_deepx_warmstart is .true. but Hamiltonian loading failed.', 'deeph_try_load_hamiltonian')
+    end if
+
+  end function deeph_try_load_hamiltonian
+
+  subroutine deeph_apply_delta_to_density()
+    integer :: i_spin
+    integer :: i_coords
+
+    if (n_spin .eq. 1) then
+      i_spin = 1
+      rho(i_spin,:) = rho(i_spin,:) + delta_rho_KS(:,i_spin)
+      if (use_density_gradient) then
+        do i_coords = 1, 3
+          rho_gradient(i_coords,i_spin,:) = &
+               rho_gradient(i_coords,i_spin,:) + &
+               delta_rho_gradient(i_coords,:,i_spin)
+        end do
+        if (use_meta_gga) then
+          kinetic_density(i_spin,:) = kinetic_density(i_spin,:) + delta_kinetic_density(:,i_spin)
+        end if
+      end if
+    else
+      rho(1,:) = rho(1,:) + 0.5d0*(delta_rho_KS(:,1)+delta_rho_KS(:,2))
+      rho(2,:) = rho(2,:) + 0.5d0*(delta_rho_KS(:,1)-delta_rho_KS(:,2))
+      if (use_density_gradient) then
+        do i_coords = 1, 3
+            rho_gradient(i_coords,1,:) = rho_gradient(i_coords,1,:) + &
+                0.5d0 * (delta_rho_gradient(i_coords,:,1) + delta_rho_gradient(i_coords,:,2))
+            rho_gradient(i_coords,2,:) = rho_gradient(i_coords,2,:) + &
+                0.5d0 * (delta_rho_gradient(i_coords,:,1) - delta_rho_gradient(i_coords,:,2))
+        end do
+        if (use_meta_gga) then
+          kinetic_density(1,:) = kinetic_density(1,:) + 0.5d0*(delta_kinetic_density(:,1)+delta_kinetic_density(:,2))
+          kinetic_density(2,:) = kinetic_density(2,:) + 0.5d0*(delta_kinetic_density(:,1)-delta_kinetic_density(:,2))
+        end if
+      end if
+    end if
+  end subroutine deeph_apply_delta_to_density
+
+  subroutine deeph_compute_hamiltonian_fingerprint(hamiltonian, norm2_out, maxabs_out)
+    real*8, dimension(n_hamiltonian_matrix_size, n_spin), intent(in) :: hamiltonian
+    real*8, dimension(n_spin), intent(out) :: norm2_out
+    real*8, dimension(n_spin), intent(out) :: maxabs_out
+    integer :: i_spin
+    integer :: i
+    real*8 :: v
+    real*8 :: av
+
+    norm2_out = 0.d0
+    maxabs_out = 0.d0
+
+    do i_spin = 1, n_spin
+      do i = 1, n_hamiltonian_matrix_size
+        v = hamiltonian(i, i_spin)
+        av = abs(v)
+        norm2_out(i_spin) = norm2_out(i_spin) + v * v
+        if (av > maxabs_out(i_spin)) maxabs_out(i_spin) = av
+      end do
+      norm2_out(i_spin) = sqrt(norm2_out(i_spin))
+    end do
+  end subroutine deeph_compute_hamiltonian_fingerprint
+
+  subroutine deeph_log_hamiltonian_fingerprint(hamiltonian, stage)
+    real*8, dimension(n_hamiltonian_matrix_size, n_spin), intent(in) :: hamiltonian
+    character(len=*), intent(in) :: stage
+
+    character(kind=c_char, len=1), dimension(128) :: stage_c
+
+    call deeph_copy_to_c_string(stage, stage_c)
+    call deeph_log_hamiltonian_fingerprint_c(hamiltonian, int(n_hamiltonian_matrix_size, c_int), int(n_spin, c_int), stage_c, int(myid, c_int))
+  end subroutine deeph_log_hamiltonian_fingerprint
+
+  subroutine deeph_dump_hamiltonian(hamiltonian, filename)
+    real*8, dimension(n_hamiltonian_matrix_size, n_spin), intent(in) :: hamiltonian
+    character(len=*), intent(in) :: filename
+
+    character(kind=c_char, len=1), dimension(256) :: filename_c
+
+    call deeph_copy_to_c_string(filename, filename_c)
+    call deeph_dump_hamiltonian_c(hamiltonian, int(n_hamiltonian_matrix_size, c_int), int(n_spin, c_int), filename_c, int(myid, c_int))
+  end subroutine deeph_dump_hamiltonian
+
+  subroutine deeph_copy_to_c_string(str_in, str_out)
+    character(len=*), intent(in) :: str_in
+    character(kind=c_char, len=1), dimension(:), intent(out) :: str_out
+    integer :: i, n
+
+    str_out = c_null_char
+    n = min(len_trim(str_in), size(str_out)-1)
+    do i = 1, n
+      str_out(i) = str_in(i:i)
+    end do
+    str_out(n+1) = c_null_char
+  end subroutine deeph_copy_to_c_string
+
+  subroutine deeph_walltime_now(t)
+    real*8, intent(out) :: t
+    integer :: count
+    integer :: rate
+    integer :: maxv
+
+    call system_clock(count, rate, maxv)
+    if (rate > 0) then
+      t = dble(count) / dble(rate)
+    else
+      t = 0.d0
+    end if
+  end subroutine deeph_walltime_now
+
