@@ -0,0 +1,58 @@
+# Initial cache for FHI-aims with DeepH-JAX (DeepX) reverse interface enabled
+# Usage:
+#   cmake -S . -B build_deeph -C initial_cache.cmake
+#
+# Customize the paths/compilers below to your machine before first configure.
+
+# -------------------- Compilers --------------------
+# Intel oneAPI MPI wrappers (recommended for MKL + ScaLAPACK)
+set(CMAKE_Fortran_COMPILER "mpiifx" CACHE STRING "" FORCE)
+set(CMAKE_C_COMPILER "mpiicx" CACHE STRING "" FORCE)
+set(CMAKE_CXX_COMPILER "icpx" CACHE STRING "" FORCE)
+
+# -------------------- Flags --------------------
+set(CMAKE_Fortran_FLAGS "-O3 -ip -fp-model precise" CACHE STRING "" FORCE)
+set(Fortran_MIN_FLAGS "-O0 -fp-model precise" CACHE STRING "" FORCE)
+set(CMAKE_C_FLAGS "-O3 -ip -fp-model precise -std=gnu99" CACHE STRING "" FORCE)
+set(CMAKE_CXX_FLAGS "-O3 -ip -fp-model precise" CACHE STRING "" FORCE)
+
+# -------------------- External include/lib paths --------------------
+# HDF5 is required at runtime for DeepX reverse loading.
+# Keep HDF5_HOME in environment, e.g. export HDF5_HOME=/path/to/hdf5
+set(INC_PATHS "$ENV{HDF5_HOME}/include" CACHE STRING "" FORCE)
+
+# MKL + HDF5 library paths
+set(LIB_PATHS "/path/to/mkl;$ENV{HDF5_HOME}/lib" CACHE STRING "" FORCE)
+
+# Core link libraries (order matters)
+set(LIBS "mkl_intel_lp64 mkl_sequential mkl_core mkl_blacs_intelmpi_lp64 mkl_scalapack_lp64" CACHE STRING "" FORCE)
+#set(LIBS "mkl_intel_lp64 mkl_sequential mkl_core mkl_blacs_intelmpi_lp64 mkl_scalapack_lp64 hdf5_fortran hdf5_hl_fortran hdf5_hl hdf5 z" CACHE STRING "" FORCE)
+
+# -------------------- Feature switches --------------------
+set(USE_MPI ON CACHE BOOL "" FORCE)
+set(USE_SCALAPACK ON CACHE BOOL "" FORCE)
+set(USE_LIBXC ON CACHE BOOL "" FORCE)
+set(USE_HDF5 ON CACHE BOOL "" FORCE)
+set(USE_RLSY ON CACHE BOOL "" FORCE)
+
+# Build as shared lib
+#set(BUILD_SHARED_LIBS ON CACHE STRING "")
+
+# Optional: ELPA kernel selection (GENERIC/AVX/AVX2/AVX512)
+set(ELPA2_KERNEL "" CACHE STRING "Change to AVX/AVX2/AVX512 on Intel CPUs" FORCE)
+
+# Optional extras
+#set(USE_COOP ON CACHE BOOL "" FORCE)
+
+# -------------------- DeepX reverse interface integration --------------------
+# User settings (only these two)
+set(DEEPH_HDF5_ROOT "/path/to/hdf5" CACHE PATH "Path to HDF5 installation root" FORCE)
+set(DEEPH_ENABLE_HDF5_FOR_INTERFACE ON CACHE BOOL "Enable DeepX interface with HDF5 C API" FORCE)
+
+# Map user settings to existing CMake options/variables.
+if (DEEPH_ENABLE_HDF5_FOR_INTERFACE)
+	set(USE_DEEPH_INTERFACE ON CACHE BOOL "" FORCE)
+	set(HDF5_ROOT "${DEEPH_HDF5_ROOT}" CACHE PATH "" FORCE)
+else()
+	set(USE_DEEPH_INTERFACE OFF CACHE BOOL "" FORCE)
+endif()

