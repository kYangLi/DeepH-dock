+module rs_mx_trans_interface
+  use iso_c_binding, only: c_char, c_int, c_double, c_null_char
+  use localorb_io, only: localorb_info, use_unit, OL_norm
+  use dimensions, only: n_atoms, n_basis, n_basis_fns, n_spin, n_hamiltonian_matrix_size
+  use pbc_lists, only: n_cells_in_hamiltonian, cell_index, index_hamiltonian, column_index_hamiltonian, &
+                       kweight_occs, de_kweight_occs
+  use basis, only: basis_fn, basis_atom, basisfn_n, basis_l, basis_m, basisfn_type
+  use species_data, only: species_z, l_shell_max
+  use geometry, only: species
+  use runtime_choices
+  use physics
+  use mixing
+  use grids
+  use mpi_tasks, only: myid, aims_stop
+  use timing, only: number_of_loops
+  implicit none
+  private
+
+  public :: deeph_try_load_hamiltonian
+  public :: deeph_should_skip_first_integration
+  public :: deeph_begin_scf_cycle
+  public :: deeph_prepare_pre_scf_alignment
+  public :: deeph_prepare_iteration_hamiltonian
+  public :: deeph_should_skip_hamiltonian_updates
+  public :: deeph_maybe_inject_first_iteration
+  public :: deeph_maybe_log_preks_fingerprint
+  public :: deeph_should_force_density_hotstart
+  public :: deeph_finalize_hotstart_nomix
+
+  interface
+    function deeph_load_and_map_c(deeph_dir, n_atoms_in, n_basis_in, n_spin_in, n_cells_in, n_ham_size_in, &
+      cell_index_in, idx_start_in, idx_end_in, col_index_in, basis_fn_in, basis_atom_in, basisfn_n_in, basis_l_in, basis_m_in, basisfn_type_in, atom_z_in, &
+      ham_out) bind(C, name="deeph_load_and_map_c") result(ierr)
+      import :: c_char, c_int, c_double
+      character(c_char), dimension(*), intent(in) :: deeph_dir
+      integer(c_int), value :: n_atoms_in, n_basis_in, n_spin_in, n_cells_in, n_ham_size_in
+      integer(c_int), dimension(*), intent(in) :: cell_index_in
+      integer(c_int), dimension(*), intent(in) :: idx_start_in
+      integer(c_int), dimension(*), intent(in) :: idx_end_in
+      integer(c_int), dimension(*), intent(in) :: col_index_in
+      integer(c_int), dimension(*), intent(in) :: basis_fn_in
+      integer(c_int), dimension(*), intent(in) :: basis_atom_in
+      integer(c_int), dimension(*), intent(in) :: basisfn_n_in
+      integer(c_int), dimension(*), intent(in) :: basis_l_in
+      integer(c_int), dimension(*), intent(in) :: basis_m_in
+      integer(c_int), dimension(*), intent(in) :: basisfn_type_in
+      integer(c_int), dimension(*), intent(in) :: atom_z_in
+      real(c_double), dimension(*), intent(out) :: ham_out
+      integer(c_int) :: ierr
+    end function deeph_load_and_map_c
+
+    subroutine deeph_state_begin_scf_cycle_c() bind(C, name='deeph_state_begin_scf_cycle_c')
+    end subroutine deeph_state_begin_scf_cycle_c
+
+    function deeph_state_get_restart_used_c() bind(C, name='deeph_state_get_restart_used_c') result(flag)
+      import :: c_int
+      integer(c_int) :: flag
+    end function deeph_state_get_restart_used_c
+
+    function deeph_state_get_injected_this_iteration_c() bind(C, name='deeph_state_get_injected_this_iteration_c') result(flag)
+      import :: c_int
+      integer(c_int) :: flag
+    end function deeph_state_get_injected_this_iteration_c
+
+    subroutine deeph_state_set_injected_this_iteration_c(flag) bind(C, name='deeph_state_set_injected_this_iteration_c')
+      import :: c_int
+      integer(c_int), value :: flag
+    end subroutine deeph_state_set_injected_this_iteration_c
+
+    function deeph_state_get_force_density_hotstart_c() bind(C, name='deeph_state_get_force_density_hotstart_c') result(flag)
+      import :: c_int
+      integer(c_int) :: flag
+    end function deeph_state_get_force_density_hotstart_c
+
+    subroutine deeph_state_set_force_density_hotstart_c(flag) bind(C, name='deeph_state_set_force_density_hotstart_c')
+      import :: c_int
+      integer(c_int), value :: flag
+    end subroutine deeph_state_set_force_density_hotstart_c
+
+    function deeph_try_load_autodetect_c(use_local_index_in, n_atoms_in, n_basis_in, n_spin_in, n_cells_in, n_ham_size_in, &
+      cell_index_in, idx_start_in, idx_end_in, col_index_in, basis_fn_in, basis_atom_in, basisfn_n_in, basis_l_in, basis_m_in, basisfn_type_in, atom_z_in, &
+      ham_out) bind(C, name='deeph_try_load_autodetect_c') result(ierr)
+      import :: c_int, c_double
+      integer(c_int), value :: use_local_index_in
+      integer(c_int), value :: n_atoms_in, n_basis_in, n_spin_in, n_cells_in, n_ham_size_in
+      integer(c_int), dimension(*), intent(in) :: cell_index_in
+      integer(c_int), dimension(*), intent(in) :: idx_start_in
+      integer(c_int), dimension(*), intent(in) :: idx_end_in
+      integer(c_int), dimension(*), intent(in) :: col_index_in
+      integer(c_int), dimension(*), intent(in) :: basis_fn_in
+      integer(c_int), dimension(*), intent(in) :: basis_atom_in
+      integer(c_int), dimension(*), intent(in) :: basisfn_n_in
+      integer(c_int), dimension(*), intent(in) :: basis_l_in
+      integer(c_int), dimension(*), intent(in) :: basis_m_in
+      integer(c_int), dimension(*), intent(in) :: basisfn_type_in
+      integer(c_int), dimension(*), intent(in) :: atom_z_in
+      real(c_double), dimension(*), intent(out) :: ham_out
+      integer(c_int) :: ierr
+    end function deeph_try_load_autodetect_c
+
+    subroutine deeph_log_hamiltonian_fingerprint_c(ham_in, n_ham_size_in, n_spin_in, stage_in, myid_in) bind(C, name='deeph_log_hamiltonian_fingerprint_c')
+      import :: c_char, c_int, c_double
+      real(c_double), dimension(*), intent(in) :: ham_in
+      integer(c_int), value :: n_ham_size_in, n_spin_in, myid_in
+      character(c_char), dimension(*), intent(in) :: stage_in
+    end subroutine deeph_log_hamiltonian_fingerprint_c
+
+    subroutine deeph_dump_hamiltonian_c(ham_in, n_ham_size_in, n_spin_in, filename_in, myid_in) bind(C, name='deeph_dump_hamiltonian_c')
+      import :: c_char, c_int, c_double
+      real(c_double), dimension(*), intent(in) :: ham_in
+      integer(c_int), value :: n_ham_size_in, n_spin_in, myid_in
+      character(c_char), dimension(*), intent(in) :: filename_in
+    end subroutine deeph_dump_hamiltonian_c
+  end interface
+
+  real*8, parameter :: deeph_fingerprint_tol = 1.0d-9
+  logical, save :: deeph_fingerprint_ref_valid = .false.
+  real*8, allocatable, save :: deeph_fingerprint_ref_norm2(:)
+  real*8, allocatable, save :: deeph_fingerprint_ref_maxabs(:)
+  logical, save :: deeph_injection_timing_valid = .false.
+  real*8, save :: deeph_injection_cpu_elapsed = 0.d0
+  real*8, save :: deeph_injection_wall_elapsed = 0.d0
+  integer, parameter :: DEEPH_INVALID_LOOP = -huge(0)
+  integer, save :: deeph_last_prepare_loop = DEEPH_INVALID_LOOP
+
+contains
+
+  subroutine deeph_begin_scf_cycle()
+    call deeph_state_begin_scf_cycle_c()
+    call deeph_state_set_injected_this_iteration_c(0_c_int)
+    deeph_fingerprint_ref_valid = .false.
+    deeph_injection_timing_valid = .false.
+    deeph_injection_cpu_elapsed = 0.d0
+    deeph_injection_wall_elapsed = 0.d0
+    deeph_last_prepare_loop = DEEPH_INVALID_LOOP
+    if (allocated(deeph_fingerprint_ref_norm2)) deallocate(deeph_fingerprint_ref_norm2)
+    if (allocated(deeph_fingerprint_ref_maxabs)) deallocate(deeph_fingerprint_ref_maxabs)
+    allocate(deeph_fingerprint_ref_norm2(n_spin))
+    allocate(deeph_fingerprint_ref_maxabs(n_spin))
+    deeph_fingerprint_ref_norm2 = 0.d0
+    deeph_fingerprint_ref_maxabs = 0.d0
+  end subroutine deeph_begin_scf_cycle
+
+  subroutine deeph_prepare_iteration_hamiltonian(hamiltonian)
+    real*8, dimension(n_hamiltonian_matrix_size, n_spin), intent(inout) :: hamiltonian
+    call deeph_maybe_inject_first_iteration(hamiltonian)
+  end subroutine deeph_prepare_iteration_hamiltonian
+
+  logical function deeph_should_skip_hamiltonian_updates()
