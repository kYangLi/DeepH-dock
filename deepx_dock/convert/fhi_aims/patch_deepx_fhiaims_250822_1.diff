+  subroutine deeph_maybe_inject_first_iteration(hamiltonian)
+    real*8, dimension(n_hamiltonian_matrix_size, n_spin), intent(inout) :: hamiltonian
+
+    character(len=200) :: info_str
+    integer :: i_spin
+    real*8 :: t_cpu_start
+    real*8 :: t_cpu_after_load
+    real*8 :: t_cpu_end
+    real*8 :: t_wall_start
+    real*8 :: t_wall_after_load
+    real*8 :: t_wall_end
+
+    if (number_of_loops /= deeph_last_prepare_loop) then
+      deeph_last_prepare_loop = number_of_loops
+      call deeph_state_set_injected_this_iteration_c(0_c_int)
+    end if
+
+    if (number_of_loops /= 1) return
+    if (deeph_state_get_injected_this_iteration_c() /= 0_c_int) return
+    if (use_local_index) return
+
+    call cpu_time(t_cpu_start)
+    call deeph_walltime_now(t_wall_start)
+
+    if (.not. deeph_try_load_hamiltonian(hamiltonian)) return
+
+    call cpu_time(t_cpu_after_load)
+    call deeph_walltime_now(t_wall_after_load)
+
+    call deeph_state_set_injected_this_iteration_c(1_c_int)
+
+    call deeph_state_set_force_density_hotstart_c(1_c_int)
+    
+    write(info_str,'(A)') ''
+    call localorb_info(info_str,use_unit,'(A)', OL_norm)
+    write(info_str,'(A)') "------------------------------------------------------------"
+    call localorb_info(info_str,use_unit,'(A)', OL_norm)
+    write(info_str,'(A)') 'DeepX restart: using injected real-space Hamiltonian in first SCF iteration.'
+    call localorb_info(info_str,use_unit,'(A)', OL_norm)
+
+    call deeph_log_hamiltonian_fingerprint(hamiltonian, 'after injection')
+    call deeph_compute_hamiltonian_fingerprint(hamiltonian, deeph_fingerprint_ref_norm2, deeph_fingerprint_ref_maxabs)
+    deeph_fingerprint_ref_valid = .true.
+
+    do i_spin = 1, n_spin
+      write(info_str,'(2X,A,I0,A,1PE24.16,A,1PE24.16)') 'DeepX reference fingerprint stored spin=', i_spin, &
+           ' ||H||2=', deeph_fingerprint_ref_norm2(i_spin), ' max|H|=', deeph_fingerprint_ref_maxabs(i_spin)
+      call localorb_info(info_str,use_unit,'(A)', OL_norm)
+    end do
+
+        call cpu_time(t_cpu_end)
+        call deeph_walltime_now(t_wall_end)
+
+        deeph_injection_cpu_elapsed = t_cpu_end - t_cpu_start
+        deeph_injection_wall_elapsed = t_wall_end - t_wall_start
+        deeph_injection_timing_valid = .true.
+
+        write(info_str,'(2X,A,1PE12.5,A,1PE12.5,A)') 'DeepX timing (injection load/map): cpu=', &
+          t_cpu_after_load - t_cpu_start, ' s, wall=', t_wall_after_load - t_wall_start, ' s'
+        call localorb_info(info_str,use_unit,'(A)', OL_norm)
+
+        write(info_str,'(2X,A,1PE12.5,A,1PE12.5,A)') 'DeepX timing (injection fingerprint-ref): cpu=', &
+          t_cpu_end - t_cpu_after_load, ' s, wall=', t_wall_end - t_wall_after_load, ' s'
+        call localorb_info(info_str,use_unit,'(A)', OL_norm)
+
+        write(info_str,'(2X,A,1PE12.5,A,1PE12.5,A)') 'DeepX timing (injection subtotal): cpu=', &
+          deeph_injection_cpu_elapsed, ' s, wall=', deeph_injection_wall_elapsed, ' s'
+        call localorb_info(info_str,use_unit,'(A)', OL_norm)
+        write(info_str,'(A)') "------------------------------------------------------------"
+        call localorb_info(info_str,use_unit,'(A)', OL_norm)
+        write(info_str,'(A)') ''
+        call localorb_info(info_str,use_unit,'(A)', OL_norm)
+  end subroutine deeph_maybe_inject_first_iteration
+
+  subroutine deeph_maybe_log_preks_fingerprint(hamiltonian)
+    real*8, dimension(n_hamiltonian_matrix_size, n_spin), intent(in) :: hamiltonian
+    real*8, allocatable :: norm2_now(:), maxabs_now(:)
+    real*8 :: d_norm2, d_maxabs
+    character(len=200) :: info_str
+    integer :: i_spin
+    logical :: match_all
+    real*8 :: t_cpu_start
+    real*8 :: t_cpu_end
+    real*8 :: t_wall_start
+    real*8 :: t_wall_end
+    real*8 :: t_cpu_preks
+    real*8 :: t_wall_preks
+
+    if (number_of_loops /= 1) return
+    if (deeph_state_get_injected_this_iteration_c() == 0_c_int) return
+
+    call cpu_time(t_cpu_start)
+    call deeph_walltime_now(t_wall_start)
+
+    write(info_str,'(A)') ''
+    call localorb_info(info_str,use_unit,'(A)', OL_norm)
+    write(info_str,'(A)') "------------------------------------------------------------"
+    call localorb_info(info_str,use_unit,'(A)', OL_norm)
+
+    call deeph_log_hamiltonian_fingerprint(hamiltonian, 'before KS solve')
+    if (.not. deeph_fingerprint_ref_valid) then
+      write(info_str,'(2X,A)') 'DeepX fingerprint consistency check skipped: no injection reference fingerprint available.'
+      call localorb_info(info_str,use_unit,'(A)', OL_norm)
+      write(info_str,'(A)') "------------------------------------------------------------"
+      call localorb_info(info_str,use_unit,'(A)', OL_norm)
+      write(info_str,'(A)') ''
+      call localorb_info(info_str,use_unit,'(A)', OL_norm)
+      return
+    end if
+
+    allocate(norm2_now(n_spin), maxabs_now(n_spin))
+    call deeph_compute_hamiltonian_fingerprint(hamiltonian, norm2_now, maxabs_now)
+
+    match_all = .true.
+    do i_spin = 1, n_spin
+      d_norm2 = abs(norm2_now(i_spin) - deeph_fingerprint_ref_norm2(i_spin))
+      d_maxabs = abs(maxabs_now(i_spin) - deeph_fingerprint_ref_maxabs(i_spin))
+
+      if ((d_norm2 > deeph_fingerprint_tol) .or. (d_maxabs > deeph_fingerprint_tol)) then
+        match_all = .false.
+      end if
+
+      write(info_str,'(2X,A,I0,A,1PE12.5,A,1PE12.5,A,1PE12.5)') &
+           'DeepX fingerprint delta spin=', i_spin, ' d||H||2=', d_norm2, ' dmax|H|=', d_maxabs, &
+           ' tol=', deeph_fingerprint_tol
+      call localorb_info(info_str,use_unit,'(A)', OL_norm)
+    end do
+
+    if (match_all) then
+      write(info_str,'(2X,A)') 'DeepX fingerprint consistency: PASS (Hamiltonian unchanged before KS solve).'
+    else
+      write(info_str,'(2X,A)') 'DeepX fingerprint consistency: FAIL (Hamiltonian changed before KS solve).'
+    end if
+    call localorb_info(info_str,use_unit,'(A)', OL_norm)
+
+    call cpu_time(t_cpu_end)
+    call deeph_walltime_now(t_wall_end)
+    t_cpu_preks = t_cpu_end - t_cpu_start
+    t_wall_preks = t_wall_end - t_wall_start
+
+    write(info_str,'(2X,A,1PE12.5,A,1PE12.5,A)') 'DeepX timing (pre-KS consistency check): cpu=', &
+         t_cpu_preks, ' s, wall=', t_wall_preks, ' s'
+    call localorb_info(info_str,use_unit,'(A)', OL_norm)
+
+    if (deeph_injection_timing_valid) then
+      write(info_str,'(2X,A,1PE12.5,A,1PE12.5,A)') 'DeepX timing (first-injection total): cpu=', &
+           deeph_injection_cpu_elapsed + t_cpu_preks, ' s, wall=', deeph_injection_wall_elapsed + t_wall_preks, ' s'
+      call localorb_info(info_str,use_unit,'(A)', OL_norm)
+    end if
+
+    write(info_str,'(A)') "------------------------------------------------------------"
+    call localorb_info(info_str,use_unit,'(A)', OL_norm)
+    write(info_str,'(A)') ''
+    call localorb_info(info_str,use_unit,'(A)', OL_norm)
+
+    deallocate(norm2_now, maxabs_now)
+  end subroutine deeph_maybe_log_preks_fingerprint
+
+  logical function deeph_should_skip_first_integration()
+    deeph_should_skip_first_integration = (deeph_state_get_restart_used_c() /= 0_c_int)
