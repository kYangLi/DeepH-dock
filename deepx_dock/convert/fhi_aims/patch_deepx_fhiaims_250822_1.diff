+static void trim_inplace(char *s) {
+    size_t n;
+    char *start;
+    if (!s) return;
+    n = strlen(s);
+    while (n > 0 && isspace((unsigned char)s[n - 1])) {
+        s[n - 1] = '\0';
+        --n;
+    }
+    start = s;
+    while (*start && isspace((unsigned char)*start)) start++;
+    if (start != s) {
+        memmove(s, start, strlen(start) + 1);
+    }
